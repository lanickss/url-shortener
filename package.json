{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Réducteur d'URL en Node.js/Express (API REST + client)",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.mjs",
    "prod": "cross-env NODE_ENV=production node server.mjs",
    "start": "node server.mjs",
    "format": "prettier --write \"**/*.mjs\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.9",
    "serve-favicon": "^2.5.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2"
  }
}
